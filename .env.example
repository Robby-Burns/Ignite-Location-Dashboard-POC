# ==============================================================================
# Database Configuration
# ==============================================================================
# Neon PostgreSQL Connection String (or set DATABASE_URL)
# Format: postgresql://<user>:<password>@<ep-identifier>.region.aws.neon.tech/<dbname>?sslmode=require
NEON_DATABASE_URL=postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local fallback (uncomment if you want to explicitly use local SQLite):
# DATABASE_URL=sqlite:///./ignite_facility.db

# ==============================================================================
# LLM / AI Client Configuration
# ==============================================================================

# --- Option 1: OpenRouter (Recommended for multi-model flexibility) ---
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Popular OpenRouter Models:
# - google/gemini-2.0-flash-001 (Fast, cheap, reliable JSON - Recommended)
# - anthropic/claude-3.5-haiku
# - anthropic/claude-3.7-sonnet
# - openai/gpt-4o-mini
# - deepseek/deepseek-chat
# - meta-llama/llama-3.3-70b-instruct
LLM_MODEL=google/gemini-2.0-flash-001

# --- Option 2: Direct Google Gemini ---
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash

# --- Option 3: Direct OpenAI ---
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# --- Optional Provider Override (auto-detected if omitted) ---
# LLM_PROVIDER=openrouter  # choices: openrouter, gemini, openai
